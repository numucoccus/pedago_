# ---- Runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
API_BASE_PATH=/api/v1
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# ---- Supabase (service role stays server-side only) ----
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Either the legacy shared JWT secret or the JWKS URL for asymmetric signing keys.
SUPABASE_JWT_SECRET=replace-with-project-jwt-secret
# SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://<project>.supabase.co/auth/v1

# supabase | memory (memory is for local development and tests only)
DATA_STORE=supabase
# inngest | inline (inline runs jobs in-process)
JOB_DISPATCHER=inline
INNGEST_APP_ID=pedago-backend
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ---- AI provider ----
# openai_compatible | fake (fake is deterministic and offline; not allowed in production)
AI_PROVIDER=fake
AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
AI_MODEL=gpt-4o-mini
# AI_VISION_MODEL=gpt-4o-mini
AI_TRANSCRIPTION_MODEL=whisper-1
AI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector(<dimension>) column in document_chunks (1536 documented in packages/shared).
AI_EMBEDDING_DIMENSION=1536
AI_TIMEOUT_MS=90000
AI_MAX_RETRIES=2
# AI_INPUT_COST_PER_1K_USD=0.00015
# AI_OUTPUT_COST_PER_1K_USD=0.0006

# ---- Research sources ----
RESEARCH_SOURCES=openalex,semantic_scholar,crossref,arxiv
# OPENALEX_MAILTO=you@university.edu
# SEMANTIC_SCHOLAR_API_KEY=
# CROSSREF_MAILTO=you@university.edu
# UNPAYWALL_EMAIL=you@university.edu
RESEARCH_TIMEOUT_MS=20000

# ---- Uploads, exports, retention ----
MAX_UPLOAD_BYTES=52428800
SIGNED_URL_TTL_SECONDS=300
EXPORT_URL_TTL_SECONDS=900
DEFAULT_RETENTION_DAYS=365

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
EXPENSIVE_RATE_LIMIT_MAX=30

# ---- Observability (optional) ----
# SENTRY_DSN=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
